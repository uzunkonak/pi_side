{
  "name": "@uzunkonak/pi_side",
  "version": "0.1.0",
  "description": "Side conversations in Pi with separate history, shared context, and editable handoff drafts",
  "type": "module",
  "license": "MIT",
  "author": "Caner Uzunkonak",
  "homepage": "https://github.com/uzunkonak/pi_side#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uzunkonak/pi_side.git"
  },
  "bugs": {
    "url": "https://github.com/uzunkonak/pi_side/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-agent",
    "side-conversation",
    "context-isolation",
    "coding-agent",
    "typescript"
  ],
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "extensions/side.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "@earendil-works/pi-ai": "0.84.4"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-timeout=30000 test/*.test.ts",
    "test:e2e": "python3 test/terminal-smoke.py",
    "prepublishOnly": "npm run check"
  }
}
